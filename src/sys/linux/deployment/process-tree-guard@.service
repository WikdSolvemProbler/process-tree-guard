[Unit]
Description=Process Tree Guard one invocation
BindsTo=process-tree-guard.socket
After=process-tree-guard.socket
JobTimeoutSec=20
JobRunningTimeoutSec=20
[Service]
Type=exec
ExitType=main
ExecStart=/usr/libexec/process-tree-guard-root --service
User=root
Group=root
WorkingDirectory=/
UMask=0077
RuntimeDirectory=process-tree-guard/%n
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=no
Delegate=yes
DelegateSubgroup=supervisor
RuntimeMaxSec=20
RuntimeRandomizedExtraSec=0
TimeoutStartSec=20
TimeoutStopSec=5
TimeoutStartFailureMode=kill
TimeoutStopFailureMode=kill
KillMode=control-group
KillSignal=SIGKILL
FinalKillSignal=SIGKILL
SendSIGKILL=yes
Restart=no
NotifyAccess=none
NoNewPrivileges=yes
StandardInput=null
StandardOutput=null
StandardError=journal
LimitNOFILE=8192
