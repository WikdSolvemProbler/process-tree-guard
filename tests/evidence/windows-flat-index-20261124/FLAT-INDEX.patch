+const REMOVED_POSITION: usize = usize::MAX;
+
 #[derive(Default)]
+struct RateIndex {
+    entries: Vec<(RateKey, usize)>,
+}
+
+impl RateIndex {
+    fn search(&self, key: RateKey) -> Result<usize, usize> {
+        self.entries.binary_search_by_key(&key, |&(entry_key, _)| entry_key)
+    }
+
+    fn position(&self, key: RateKey) -> Option<usize> {
+        self.search(key).ok().map(|slot| self.entries[slot].1)
+    }
+
+    fn insert(&mut self, key: RateKey, position: usize) {
+        let slot = self.search(key).expect_err("a new rate key is absent");
+        self.entries.insert(slot, (key, position));
+    }
+
+    fn set_position(&mut self, key: RateKey, position: usize) {
+        let slot = self.search(key).expect("an existing rate has an index entry");
+        self.entries[slot].1 = position;
+    }
+
+    fn compact(&mut self) {
+        self.entries.retain(|&(_, position)| position != REMOVED_POSITION);
+    }
+}
