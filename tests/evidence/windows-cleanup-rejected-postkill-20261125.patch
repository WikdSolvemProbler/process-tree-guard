+fn observe_job_accounting(
+    deadline: Instant, mut now: impl FnMut() -> Instant, query: impl FnOnce() -> Result<u32, u32>,
+) -> Option<(Result<u32, u32>, bool)> {
+    if now() >= deadline { return None; }
+    let result = query();
+    Some((result, now() < deadline))
