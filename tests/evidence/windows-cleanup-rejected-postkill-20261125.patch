+/// Some means the initial accounting is conclusive for dispatch. A late zero
+/// needs no kill, but cannot certify cleanup. Unknown or active Jobs still get
+/// exactly one termination request, even if that probe consumed the budget.
+pub(super) fn begin_job_cleanup(
+    deadline: Instant, now: impl FnMut() -> Instant,
+    query: impl FnOnce() -> Result<u32, u32>, terminate: impl FnOnce() -> i32,
+    failure: &mut Option<MemberCaptureFailure>, termination_error: &mut Option<u32>,
+) -> Option<bool> {
+    let observed = observe_job_accounting(deadline, now, query);
+    let empty = matches!(observed, Some((Ok(0), _)));
+    if !empty {
+        observe_job_termination(termination_error, terminate);
+    }
+    if let Some((result, false)) = observed {
+        failure.get_or_insert(MemberCaptureFailure::JobAccountingOverdue { result });
+        return Some(false);
+    }
+    empty.then_some(true)
+}
